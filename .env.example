# 이 파일을 복사해서 .env 로 저장한 뒤 실제 키를 채워 넣으세요.
# cp .env.example .env

# Anthropic Claude API (홍보 문구를 실시간 AI로 생성)
# 키가 없어도 앱은 정상 동작하며, 대신 규칙 기반 예시 문구가 자동으로 채워집니다.
ANTHROPIC_API_KEY=

# OpenRouter API (하나의 키로 Claude 등 여러 텍스트/이미지 모델 호출 — ANTHROPIC_API_KEY 대신 사용 가능)
# 발급: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# 릴스용 사진을 애니메이션/일러스트 스타일로 다시 그릴 때 쓰는 이미지 생성 모델
# 없어도 앱은 정상 동작하며, 원본 사진 그대로 릴스를 만듭니다.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 네이버 검색 오픈API (블로그 검색 - 리뷰 근사치 소스)
# 없어도 앱은 정상 동작하며, 블로그 후기 가져오기 버튼만 안내 메시지를 보여줍니다.
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 제미나이 API (AI 일러스트 만화 - 안자이 미즈마루풍 오마주 생성)
# 없어도 앱은 정상 동작하며, "AI 일러스트 만화" 기능만 안내 메시지를 보여줍니다.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 이미지 생성 모델 (기본값: gemini-2.5-flash-image / 나노바나나)
# 나노바나나 2 라이트로 쓰려면: gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL=

# 카카오 로컬 API (주변 가게 검색 - Overpass/OSM보다 한국 커버리지 좋음)
# 없어도 앱은 정상 동작하며, 없으면 Overpass(OSM) 폴백을 사용합니다.
# 발급: https://developers.kakao.com/console/app (무료, 카드 등록 불필요)
KAKAO_REST_API_KEY=

# Pexels API (고품질 스톡사진 검색 - 웹에서 관련 이미지 찾기)
# 없어도 앱은 정상 동작하며, 없으면 네이버 이미지 검색으로 대체됩니다.
# 발급: https://www.pexels.com/api/new/ (무료, 카드 등록 불필요)
PEXELS_API_KEY=

# 구글 프로그래밍 가능 검색엔진(Custom Search JSON API) - "실제 웹 이미지" 구글 탭
# 없어도 앱은 정상 동작하며, 없으면 구글 탭만 안내 메시지를 보여줍니다. (무료 한도: 하루 100건)
# API 키 발급: https://console.cloud.google.com/apis/credentials (Custom Search API 활성화 필요)
# 검색엔진 ID(cx) 발급: https://programmablesearchengine.google.com/ (이미지 검색 켜고 "전체 웹 검색"으로 설정)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

PORT=3000
