{
  "id": "menu-spotlight",
  "name": "메뉴 스포트라이트형",
  "description": "훅 이후 메뉴/제품 사진을 한 컷씩 천천히 확대하며 스포트라이트처럼 보여주는 포맷. 대표 메뉴 한두 개를 임팩트 있게 보여주고 싶을 때 적합.",
  "segments": [
    {
      "id": "hook",
      "type": "hook",
      "duration": 1.5,
      "transition": "fade",
      "caption": { "maxChars": 12, "position": "center", "fontSize": 64 }
    },
    {
      "id": "spotlight",
      "type": "photo-cuts",
      "duration": 11,
      "cutCount": { "min": 3, "max": 4 },
      "transition": "zoomin",
      "caption": { "maxChars": 14, "position": "bottom", "fontSize": 46 }
    },
    {
      "id": "ending",
      "type": "endcard",
      "duration": 3,
      "transition": "fade",
      "endCard": { "showAddress": true, "cta": "지금 바로 방문해보세요" }
    }
  ]
}
